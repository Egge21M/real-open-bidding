# Public origin used in signed requests and NIP-98. HTTPS outside loopback.
ORACLE_PUBLIC_URL=http://localhost:3000
# Oracle's independently trusted Nostr identity: 64 lowercase hex characters.
ORACLE_PUBKEY=
# Stable Cashu signing secret: 32 bytes as 64 lowercase hex characters.
ORACLE_PAYMENT_PRIVATE_KEY=
ORACLE_DATABASE_PATH=data/oracle.sqlite
HOST=127.0.0.1
PORT=3000
