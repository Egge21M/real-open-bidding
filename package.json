{
  "name": "real-open-bidding",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @rob/protocol-homepage dev",
    "build": "bun run --workspaces build",
    "build:homepage": "bun run --filter @rob/protocol-homepage build",
    "lint": "bun run --workspaces lint",
    "typecheck": "bun run --workspaces typecheck",
    "test:publisher": "bun run --filter @rob/publisher --filter @rob/publisher-sdk test",
    "test:publisher:browser": "bun run --filter @rob/publisher-sdk build && bun run --filter @rob/publisher test:browser",
    "format": "bun run --workspaces format",
    "preview": "bun run --filter @rob/protocol-homepage preview"
  }
}
