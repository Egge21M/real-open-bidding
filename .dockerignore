!docs/agents/domain.md
!apps/
apps/*
!apps/protocol-homepage/
apps/protocol-homepage/*
!apps/protocol-homepage/package.json
!apps/protocol-homepage/tsconfig*.json
!apps/protocol-homepage/vite.config.ts
!apps/protocol-homepage/index.html
!apps/protocol-homepage/src/
!apps/protocol-homepage/src/**
!apps/protocol-homepage/public/
!apps/protocol-homepage/public/**
!apps/protocol-homepage/Dockerfile
!apps/protocol-homepage/nginx.conf
